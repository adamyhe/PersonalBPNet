      - family-names: Gagneur
        given-names: Julien
      - family-names: Kundaje
        given-names: Anshul
      - family-names: Zeitlinger
        given-names: Julia
    year: 2021
    doi: 10.1038/s41588-021-00782-6
    url: "https://doi.org/10.1038/s41588-021-00782-6"
    journal: Nature Genetics
    volume: "53"
    issue: "3"
    start: "354"
    end: "366"
